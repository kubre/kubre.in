---
import Layout from "../layouts/Layout.astro";
---

<Layout title="About Site" description="What kubre.in uses?">
    <style>
        .dvd {
            animation:
                dvd infinite linear 10s,
                cycle infinite step-end 10s;
        }

        @keyframes cycle {
            0% {
                background-color: #ef4444;
            }
            25% {
                background-color: #eab308;
            }
            50% {
                background-color: #22c55e;
            }
            75% {
                background-color: #3b82f6;
            }
            100% {
                background-color: #ef4444;
            }
        }

        @keyframes dvd {
            0% {
                transform: translate(120px, 0);
            }
            25% {
                transform: translate(0, 240px);
            }
            50% {
                transform: translate(120px, 345px);
            }
            75% {
                transform: translate(280px, 140px);
            }
            100% {
                transform: translate(120px, 0);
            }
        }
    </style>
    <main id="main" class="py-8 grid lg:grid-cols-2 gap-x-4 gap-y-6">
        <h1 class="col-span-2 uppercase text-2xl font-bold text-carbon-lighter">
            Engineering Technology
        </h1>
        <p class="col-span-2">What kubre.in uses?</p>
        <div class="col-span-2 space-y-4 leading-6">
            <p>
                This is the personal site of Vaibhav Kubre: a place where project write-ups,
                technical blog posts, and travel notes live without any algorithm deciding who sees
                them. Everything here is static HTML rendered ahead of time, so pages load fast,
                work without JavaScript, and stay readable for people and machines alike. Agents can
                request the same URL with an Accept header of text/markdown to get a markdown
                variant instead.
            </p>
            <p>
                The stack below is deliberately boring, because boring is what survives. Content
                lives in markdown files checked into git, styling comes from utility classes with a
                handful of custom colors, and hosting is on the edge so the site stays up whether or
                not anyone is watching it.
            </p>
        </div>
        <div class="col-span-2 flex flex-col lg:flex-row gap-8">
            <table>
                <thead>
                    <tr>
                        <th class="text-start" colspan="2">Software Stack</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>Environment</td>
                        <td>PROD</td>
                    </tr>
                    <tr>
                        <td>Frontend</td>
                        <td>Astro & TailwindCSS</td>
                    </tr>
                    <tr>
                        <td>Backend</td>
                        <td>Typescript</td>
                    </tr>
                    <tr>
                        <td>Hosting</td>
                        <td>Cloudflare pages</td>
                    </tr>
                    <tr>
                        <td>Analytics</td>
                        <td>Cloudflare</td>
                    </tr>
                </tbody>
            </table>
            <fieldset
                class="w-full max-w-[370px] aspect-square border border-carbon mx-auto relative overflow-hidden"
            >
                <p class="top-1/2 left-1/2 transform -translate-x-1/2 -translate-y-1/2 absolute">
                    No Signal
                </p>
                <div class="px-2 bg-red-200 border border-white/40 dvd inline-block text-sm">
                    kubre.in
                </div>
            </fieldset>
        </div>
    </main>
</Layout>
